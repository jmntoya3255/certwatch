# Copia este archivo como ".env" y completa tus datos reales.
# NUNCA subas el archivo ".env" real a un repositorio.

# --- Servidor SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@tudominio.com
SMTP_PASSWORD=tu_password_o_app_password
SMTP_USE_TLS=true

# --- Correo ---
EMAIL_FROM=tu_correo@tudominio.com
# Varios destinatarios separados por coma
EMAIL_TO=admin1@tudominio.com,admin2@tudominio.com

# --- Umbrales del semaforo (en dias) ---
RED_DAYS=15
YELLOW_DAYS=30
GREEN_DAYS=45

# --- Web ---
SECRET_KEY=cambia-esta-clave-por-una-aleatoria
WEB_HOST=0.0.0.0
WEB_PORT=5000

# --- Chequeo TLS ---
CHECK_TIMEOUT=8
